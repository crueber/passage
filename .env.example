# Passage environment variables.
#
# Only bootstrap settings can be set here; feature settings (sign-in methods,
# registration, sessions, branding, SMTP, rate limits, the webhook, metrics,
# themes) live in the admin UI under Settings and are stored in the database.

# Server
PASSAGE_SERVER_HOST=0.0.0.0
PASSAGE_SERVER_PORT=8080
# Required: the public URL clients use (email links, WebAuthn, OIDC discovery).
PASSAGE_SERVER_BASE_URL=https://auth.home.example.com

# Database
PASSAGE_DATABASE_PATH=/data/passage.db

# Session cookie shape (lifetime and idle timeout are in the admin UI)
PASSAGE_SESSION_COOKIE_NAME=passage_session
PASSAGE_SESSION_COOKIE_SECURE=true

# Key material
# AES-256-GCM key for TOTP secrets at rest: 64 hex chars or base64 of 32 bytes
# (`openssl rand -hex 32`). Empty uses <database.path>.key, created on first
# use. The key must stay stable across restarts.
PASSAGE_SECURITY_ENCRYPTION_KEY=
# Optional CSRF signing secret (64+ hex chars). Empty generates an ephemeral
# key at startup.
PASSAGE_CSRF_KEY=

# Logging
PASSAGE_LOG_LEVEL=info
PASSAGE_LOG_FORMAT=json

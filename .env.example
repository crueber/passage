# .env.example — copy to .env and fill in your values.
# chmod 600 .env

# ── Required ──────────────────────────────────────────────────────────────────
# The public base URL Passage is reachable at (used for WebAuthn, email links,
# and OIDC discovery — must match the URL your reverse proxy exposes to clients).
PASSAGE_SERVER_BASE_URL=https://auth.home.example.com

# ── Optional — Server ─────────────────────────────────────────────────────────
# Host port to bind Passage on the Docker host (default: 8080)
PASSAGE_PORT=8080

# ── Optional — Session ────────────────────────────────────────────────────────
PASSAGE_SESSION_DURATION_HOURS=24
# Close a session after this many minutes without use. 0 disables the idle
# timeout (the default); duration_hours still applies either way.
PASSAGE_SESSION_IDLE_TIMEOUT_MINUTES=0
PASSAGE_SESSION_COOKIE_NAME=passage_session
# Set to false only if running on http:// (local dev or HTTP-only home lab)
PASSAGE_SESSION_COOKIE_SECURE=true

# ── Optional — SMTP ───────────────────────────────────────────────────────────
# Leave PASSAGE_SMTP_HOST empty to disable all email features (password reset).
PASSAGE_SMTP_HOST=smtp.example.com
PASSAGE_SMTP_PORT=587
PASSAGE_SMTP_USERNAME=passage@example.com
PASSAGE_SMTP_PASSWORD=changeme
PASSAGE_SMTP_FROM=Passage <passage@example.com>
# Allowed values: tls | starttls | none
PASSAGE_SMTP_TLS=starttls

# ── Optional — Auth ───────────────────────────────────────────────────────────
# Allow new users to self-register (disable after initial setup in admin UI)
PASSAGE_AUTH_ALLOW_REGISTRATION=true
# bcrypt cost — increase for higher security at the cost of slower logins (10–31)
PASSAGE_AUTH_BCRYPT_COST=12
# Per-account password-login throttling. After this many consecutive invalid
# passwords the account is locked for the lockout duration. Set either value to
# 0 to disable. Locks expire automatically; an admin can unlock a user from the
# Users page. Passkeys and magic links are unaffected.
PASSAGE_AUTH_MAX_LOGIN_FAILURES=5
PASSAGE_AUTH_LOCKOUT_MINUTES=15

# ── Optional — Security webhook ───────────────────────────────────────────────
# POST every authentication event to this URL as JSON. Leave empty to disable.
# Delivery is asynchronous and at-most-once, so a slow or dead endpoint can
# never delay or fail a login.
PASSAGE_SECURITY_WEBHOOK_URL=
# Optional HMAC-SHA256 key. When set, each request carries
# X-Passage-Signature: sha256=<hex> over the raw body.
PASSAGE_SECURITY_WEBHOOK_SECRET=
# Per-request delivery timeout in seconds (1–60, default 5)
PASSAGE_SECURITY_WEBHOOK_TIMEOUT_SECONDS=5

# ── Optional — Logging ────────────────────────────────────────────────────────
# Level: debug | info | warn | error
PASSAGE_LOG_LEVEL=info
# Format: json | text
PASSAGE_LOG_FORMAT=json

# ── Optional — UI ─────────────────────────────────────────────────────────────
# Default colour theme (slate | nord | gruvbox | solarized | catppuccin |
# tokyo-night | rose-pine | everforest | kanagawa | paper). A per-browser
# override is available in admin Settings → Appearance.
PASSAGE_UI_THEME=slate
